# Plantilla procesada por la imagen oficial de nginx (envsubst al arrancar).
# Solo se sustituyen variables definidas en el entorno (BACKEND_URL), por eso
# $host, $uri, etc. de nginx no se tocan.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 1m;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/javascript image/svg+xml;

    # API: proxy al backend (mismo origen => sin CORS). Sin URI en proxy_pass,
    # así la ruta /api/... llega intacta al backend.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # Assets con hash de contenido en el nombre (main.f8974d9e3195a2f9.js): caché larga.
    location ~* "\.[0-9a-f]{16,}\.(js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|ico|webp)$" {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # SPA: fallback a index.html. index.html y ficheros sin hash nunca se cachean
    # para que cada despliegue se vea al momento.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri $uri/ /index.html;
    }
}
