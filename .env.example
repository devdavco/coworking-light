# Copia este fichero a .env y rellena los valores. NUNCA subas .env al repositorio.
# El mismo .env sirve para docker-compose.yml (local) y docker-compose.prod.yml (EC2).

# ---------- Base de datos ----------
# Local: usuario/contraseña con los que se crea el contenedor postgres.
# EC2:   usuario maestro (o de aplicación) de RDS.
DB_NAME=coworking_db
DB_USERNAME=coworking_user
DB_PASSWORD=
# Solo producción (RDS). En local se ignora: el compose apunta al contenedor postgres.
# DB_URL=jdbc:postgresql://<endpoint-rds>.rds.amazonaws.com:5432/coworking_db?sslmode=require
DB_URL=

# ---------- Seguridad ----------
# Mínimo 32 bytes. Genera uno con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=3600000

# Admin creado en el primer arranque (si ADMIN_PASSWORD está vacío no se crea)
ADMIN_EMAIL=admin@coworking.com
ADMIN_PASSWORD=

# ---------- Aplicación ----------
APP_TIMEZONE=America/Bogota
# Solo producción: orígenes HTTPS desde los que se abre la app, separados por coma y sin espacios.
# Detrás de CloudFront es obligatorio; si falta, el login responde 403 "Invalid CORS request".
# CORS_ALLOWED_ORIGINS=https://coworking.davidcorrales.dev,https://dxxxxxxxxxxxx.cloudfront.net
CORS_ALLOWED_ORIGINS=
# Swagger UI en producción (true/false)
SWAGGER_ENABLED=false
# Puerto local del frontend en docker-compose.yml
FRONTEND_PORT=80

# ---------- Imágenes Docker Hub (solo docker-compose.prod.yml) ----------
DOCKERHUB_USER=
IMAGE_TAG=1.0.0
