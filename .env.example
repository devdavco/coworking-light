# Copia este fichero a .env y rellena los valores. NUNCA subas .env al repositorio.

POSTGRES_DB=coworking_db
POSTGRES_USER=coworking_user
POSTGRES_PASSWORD=cambia-esto-por-una-password-larga

# Genera uno con: openssl rand -base64 48
JWT_SECRET=

ADMIN_EMAIL=admin@coworking.com
ADMIN_PASSWORD=cambia-esto-tambien

APP_TIMEZONE=America/Bogota

# Solo si usas Amazon RDS en lugar del contenedor postgres:
# DB_URL=jdbc:postgresql://<endpoint-rds>:5432/coworking_db
